# Google(Gmail を読むだけ)。本物は .env に入れる。.env は GitHub に上げない
# python manage.py google-key <Google Cloud で保存した合鍵のファイル> で、上の2つが入る
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 段取りさんの設定の「Google」で許可すると、自動で入る
GOOGLE_REFRESH_TOKEN=

# K'sLife(モッチのサイトの道具で、段取りさんのプログラムだけが使う。モッチ(AI)には見せない)
# 本物はご自分で .env に書く。.env は GitHub に上げない
KSLIFE_ID=
KSLIFE_PASSWORD=
